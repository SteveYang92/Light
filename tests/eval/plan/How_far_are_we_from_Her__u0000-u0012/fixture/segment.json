      "duration": 0.68,
      "speaker": "",
      "word_count": 4,
      "source_text": "What do you think?",
      "word_range": {
        "from": " What",
        "to": " think?"
      }
    },
    {
      "unit_id": "u0008",
      "start": 25.871,
      "end": 28.152,
      "duration": 2.281,
      "speaker": "",
      "word_count": 11,
      "source_text": "If you go up, it's going to get kind of baggy.",
      "word_range": {
        "from": " If",
        "to": " baggy."
      }
    },
    {
      "unit_id": "u0009",
      "start": 28.292,
      "end": 31.494,
      "duration": 3.202,
      "speaker": "",
      "word_count": 9,
      "source_text": "Although baggy is very popular now, don't you think?",
      "word_range": {
        "from": " Although",
        "to": " think?"
      }
    },
    {
      "unit_id": "u0010",
      "start": 31.954,
