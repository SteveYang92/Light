      "duration": 3.703,
      "speaker": "",
      "word_count": 11,
      "source_text": ", an introvert who falls in love with his AI assistant Samantha",
      "word_range": {
        "from": " , an",
        "to": " Samantha"
      }
    },
    {
      "unit_id": "u0002",
      "start": 10.615,
      "end": 11.615,
      "duration": 1.0,
      "speaker": "",
      "word_count": 6,
      "source_text": "Where'd you get that name from?",
      "word_range": {
        "from": " Where'd",
        "to": " from?"
      }
    },
    {
      "unit_id": "u0003",
      "start": 12.256,
      "end": 13.537,
      "duration": 1.281,
      "speaker": "",
      "word_count": 6,
      "source_text": "I gave it to myself , actually.",
      "word_range": {
        "from": " I",
        "to": " , actually."
      }
    },
    {
      "unit_id": "u0004",
      "start": 13.917,
      "end": 16.599,
      "duration": 2.682,
      "speaker": "",
      "word_count": 7,
      "source_text": "Fast forward 13 years to July 2026.",
      "word_range": {
        "from": " Fast",
        "to": " 2026."
      }
    },
    {
      "unit_id": "u0005",
      "start": 17.28,
      "end": 22.65246153846154,
      "duration": 5.372,
      "speaker": "",
      "word_count": 10,
      "source_text": "openai releases gpt live , promising a meaningful upgrade to their",
      "word_range": {
        "from": " openai",
        "to": " their"
      }
    },
    {
      "unit_id": "u0006",
